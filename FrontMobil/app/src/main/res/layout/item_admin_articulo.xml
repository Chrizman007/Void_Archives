<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/panel_secundario"
    app:cardCornerRadius="6dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_piedra"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Fila Superior: ID Corto, Categoría y Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminIdCorto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="#000000"
                android:textColor="@color/texto_gris"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_categoria"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="LORE"
                android:textColor="@color/acento_alma"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAdminEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_estado"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="PUBLICADO"
                android:textColor="@color/acento_alma"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Título de la Crónica -->
        <TextView
            android:id="@+id/tvAdminTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Título de la Crónica"
            android:textColor="@color/texto_hueso"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Metadatos: Autor y Vistas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminAutor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vasija: Administrador"
                android:textColor="@color/texto_gris"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAdminVistas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Ecos"
                android:textColor="@color/acento_alma"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/borde_piedra" />

        <!-- Fila de Acciones de la Cámara del Rey -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdminInspeccionar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_piedra"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Inspeccionar"
                android:textAllCaps="false"
                android:textColor="@color/texto_gris"
                android:textSize="11sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnAdminEditar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_boton_primario"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="✎ Reescribir"
                android:textAllCaps="false"
                android:textColor="@color/texto_hueso"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnAdminArchivar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_input_piedra"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="⊗ Al Vacío"
                android:textAllCaps="false"
                android:textColor="@color/acento_rojo"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
