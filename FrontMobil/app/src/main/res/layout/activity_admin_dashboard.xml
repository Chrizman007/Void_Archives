<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_abisal">

    <!-- Cabecera de la Cámara del Rey -->
    <LinearLayout
        android:id="@+id/headerAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_lateral"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Barra Superior: Volver, Título y Sincronizar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVolverAdmin"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_input_piedra"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="← Diario"
                android:textAllCaps="false"
                android:textColor="@color/texto_hueso"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="CÁMARA DEL REY"
                    android:textColor="@color/acento_oro"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMonarcaAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monarca: Administrador"
                    android:textColor="@color/acento_alma"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSincronizarAdmin"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_input_piedra"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="↻ Sincronizar"
                android:textAllCaps="false"
                android:textColor="@color/acento_alma"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Cuadrícula 2x2 de Tarjetas KPI Interactivas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- KPI 1: Crónicas Activas -->
            <LinearLayout
                android:id="@+id/cardKpiActivas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_boton_primario"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CRÓNICAS ACTIVAS"
                    android:textColor="@color/texto_gris"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKpiActivas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="@color/acento_alma"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- KPI 2: Forjadas por Mí -->
            <LinearLayout
                android:id="@+id/cardKpiPropias"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_piedra"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FORJADAS POR MÍ"
                    android:textColor="@color/texto_gris"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKpiPropias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="@color/acento_oro"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- KPI 3: En Revisión / Borrador -->
            <LinearLayout
                android:id="@+id/cardKpiRevision"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_piedra"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EN REVISIÓN / BORRADOR"
                    android:textColor="@color/texto_gris"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKpiRevision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="@color/acento_infeccion"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- KPI 4: Al Vacío (Archivadas) -->
            <LinearLayout
                android:id="@+id/cardKpiArchivadas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_piedra"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AL VACÍO (ARCHIVADAS)"
                    android:textColor="@color/texto_gris"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKpiArchivadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="@color/acento_vacio"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Barra de Búsqueda de Inspección -->
        <EditText
            android:id="@+id/etBuscadorAdmin"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_piedra"
            android:hint="Inspeccionar crónica por título, autor o categoría…"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/texto_hueso"
            android:textColorHint="@color/texto_gris"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvFiltroActivoAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Vista actual: CRÓNICAS ACTIVAS"
            android:textColor="@color/acento_oro"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/dividerAdmin"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borde_piedra"
        app:layout_constraintTop_toBottomOf="@+id/headerAdmin" />

    <!-- Lista de Crónicas Administrables -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminArticulos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dividerAdmin" />

    <ProgressBar
        android:id="@+id/progressAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/acento_oro"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dividerAdmin" />

    <TextView
        android:id="@+id/tvAdminEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="No hay crónicas bajo este sello de la Cámara del Rey."
        android:textAlignment="center"
        android:textColor="@color/texto_gris"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dividerAdmin" />

    <!-- Botón Flotante para Grabar Nueva Crónica desde Administración -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdminNuevoArticulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:backgroundTint="@color/boton_fondo"
        android:text="+ Grabar Crónica"
        android:textColor="@color/acento_oro"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:strokeColor="@color/acento_oro"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
