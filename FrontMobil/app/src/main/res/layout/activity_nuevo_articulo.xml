<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_abisal"
    android:orientation="vertical">

    <!-- Barra Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_lateral"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <Button
            android:id="@+id/btnCancelarArticulo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_input_piedra"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="← Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/texto_gris"
            android:textSize="12sp"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/tvTituloFormularioArticulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="FORJAR CRÓNICA EN EL DIARIO"
            android:textColor="@color/acento_oro"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borde_piedra" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_piedra"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TÍTULO DE LA CRÓNICA:"
                    android:textColor="@color/acento_alma"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTituloArticulo"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_piedra"
                    android:hint="Ej. El Caballero Vacío"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/texto_hueso"
                    android:textColorHint="@color/texto_gris"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="REGISTRO DEL REINO (CATEGORÍA):"
                    android:textColor="@color/acento_alma"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spCategoriaArticulo"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_piedra"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/lblEstadoArticulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ESTADO DE LA CRÓNICA:"
                    android:textColor="@color/acento_alma"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spEstadoArticulo"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_piedra"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <!-- Selector de Imagen desde el Celular -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="RELIQUIA MULTIMEDIA (IMAGEN):"
                    android:textColor="@color/acento_alma"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etImagenArticulo"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_piedra"
                        android:hint="Ninguna reliquia seleccionada..."
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/texto_hueso"
                        android:textColorHint="@color/texto_gris"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnSeleccionarImagen"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_boton_primario"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Galería..."
                        android:textAllCaps="false"
                        android:textColor="@color/texto_hueso"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <!-- Vista Previa de la Imagen Seleccionada -->
                <ImageView
                    android:id="@+id/ivPreviewArticulo"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_piedra"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="DESCRIPCIÓN BREVE:"
                    android:textColor="@color/acento_alma"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDescripcionArticulo"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_piedra"
                    android:gravity="top|start"
                    android:hint="Resumen corto para la tarjeta del catálogo..."
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="12dp"
                    android:textColor="@color/texto_hueso"
                    android:textColorHint="@color/texto_gris"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="LORE / ECOS DEL PASADO (CONTENIDO COMPLETO):"
                    android:textColor="@color/acento_alma"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etContenidoArticulo"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_piedra"
                    android:gravity="top|start"
                    android:hint="Escribe aquí la historia completa y detalles..."
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="12dp"
                    android:textColor="@color/texto_hueso"
                    android:textColorHint="@color/texto_gris"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGuardarArticulo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_boton_primario"
                android:text="GRABAR CRÓNICA"
                android:textColor="@color/texto_hueso"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <ProgressBar
                android:id="@+id/progressGuardarArticulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/acento_alma"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
